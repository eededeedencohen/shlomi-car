{
  "name": "shlomi-car",
  "version": "1.0.0",
  "description": "Shlomi car service management: API (Express + MongoDB) serving the built client",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:user": "node src/scripts/seedUser.js",
    "seed:templates": "node src/scripts/seedTemplates.js",
    "seed:bundles": "node src/scripts/seedBundles.js",
    "migrate:catalog": "node src/scripts/migrateCatalog.js",
    "seed:demo": "node src/scripts/seedDemo.js",
    "seed:history": "node src/scripts/seedCustomerHistory.js",
    "seed:annual": "node src/scripts/seedAnnualBundle.js",
    "recompute": "node src/scripts/recompute.js",
    "clear:data": "node src/scripts/clearData.js",
    "bundle": "node src/scripts/bundleClient.js",
    "smoke": "node src/scripts/smokeTest.js"
