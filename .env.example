# MongoDB Atlas connection. <PASSWORD> is replaced with DATABASE_PASSWORD at runtime.
DATABASE=mongodb+srv://USER:<PASSWORD>@cluster0.xxxxx.mongodb.net/shlomi-garage?retryWrites=true&w=majority
DATABASE_PASSWORD=change-me

PORT=5000

# Browser origins allowed by CORS, comma separated (Vite dev server by default). Leave empty to allow any origin.
CLIENT_ORIGIN=http://localhost:5173

# Public address of the deployed app (no trailing slash), used for the WhatsApp / Facebook link preview image.
# Optional: when empty the server uses the address the request came in on (works on Render out of the box).
PUBLIC_URL=

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Initial user created by `npm run seed:user`
SEED_USERNAME=shlomi
SEED_PASSWORD=shlomi123
SEED_NAME=שלומי
